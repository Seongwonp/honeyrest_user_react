# 백엔드 URL
VITE_BACKEND_URL=http://localhost:8080

# 관리자 페이지 URL (미설정 시 헤더의 관리자 버튼 숨김)
VITE_ADMIN_URL=http://localhost:8082

# OAuth 콜백/로그아웃 리다이렉트 기준 URL (미설정 시 window.location.origin 사용)
# 예: http://localhost:5173 → /login/kakao/callback, /login/google/callback, /login 경로가 뒤에 붙음
VITE_OAUTH_REDIRECT_URI=

# 소셜 로그인 클라이언트 ID
VITE_KAKAO_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Google Maps
VITE_APP_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAP_ID=

# Toss Payments 위젯 클라이언트 키
VITE_TOSS_WIDGET_CLIENT_KEY=

# 공휴일 API 서비스 키
VITE_HOLIDAY_API_KEY=
