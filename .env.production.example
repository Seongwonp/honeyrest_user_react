# 운영(단일 서버 Docker) 빌드에 들어가는 값 — 참고용 예시
#
# 실제 운영 빌드는 이 파일을 쓰지 않는다. honeyRest_user 저장소의 deploy/docker-compose.yml 이
# deploy/.env 의 값으로 아래 변수를 빌드 인자(build args)로 넘기고, deploy/caddy/Dockerfile 이 `npm run build` 한다.
# 로컬에서 운영과 같은 번들을 만들어 보고 싶을 때만 .env.production 으로 복사해 쓴다 (.gitignore 대상).
#   cp .env.production.example .env.production && npm run build
#
# SITE_DOMAIN 예: 152-70-12-34.sslip.io (공인 IP 기반, 도메인 없음) 또는 구입한 도메인

# 백엔드 URL: 비워 둔다 (같은 Origin). axios 가 상대 경로 /api/... 로 요청하고 Caddy 가 user-api 로 전달한다.
VITE_BACKEND_URL=

# 관리자 사이트 (헤더의 관리자 버튼 링크)
VITE_ADMIN_URL=https://admin.SITE_DOMAIN

# OAuth 콜백 기준 URL → /login/kakao/callback, /login/google/callback 이 붙는다
VITE_OAUTH_REDIRECT_URI=https://SITE_DOMAIN

# 토스페이먼츠 결제위젯 클라이언트 키 (테스트 키: test_gck_...)
VITE_TOSS_WIDGET_CLIENT_KEY=

# 소셜 로그인 클라이언트 ID (백엔드 GOOGLE_CLIENT_ID / KAKAO_CLIENT_ID 와 같은 값)
VITE_KAKAO_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Google Maps / 공휴일 API (선택)
VITE_APP_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAP_ID=
VITE_HOLIDAY_API_KEY=

# VITE_E2E 는 절대 넣지 않는다 (Playwright 전용: 토스 위젯 대신 테스트 결제 버튼이 번들에 들어감)
