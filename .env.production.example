# 운영 빌드 값 예시. 실제로는 honeyRest_user 의 deploy/.env 값이 빌드 인자로 들어간다.
# 로컬에서 운영 번들을 만들어 볼 때만 .env.production 으로 복사해서 사용
# SITE_DOMAIN 예: 152-70-12-34.sslip.io 또는 구입한 도메인

# 같은 Origin 이라 비워 둔다 (Caddy 가 /api 를 API 로 전달)
VITE_BACKEND_URL=

# 관리자 사이트
VITE_ADMIN_URL=https://admin.SITE_DOMAIN

# OAuth 콜백 기준 URL → /login/kakao/callback, /login/google/callback 이 붙는다
VITE_OAUTH_REDIRECT_URI=https://SITE_DOMAIN

# 토스 결제위젯 클라이언트 키
VITE_TOSS_WIDGET_CLIENT_KEY=

# 소셜 로그인 클라이언트 ID (백엔드와 같은 값)
VITE_KAKAO_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Google Maps / 공휴일 API (선택)
VITE_APP_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAP_ID=
VITE_HOLIDAY_API_KEY=

# VITE_E2E, VITE_DEMO 는 넣지 않는다 (테스트 결제 버튼·데모 코드가 번들에 들어감)
